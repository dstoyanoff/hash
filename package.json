{
  "name": "hash",
  "private": true,
  "version": "0.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tabler/icons": "3.48.0",
    "@types/node": "24.13.6",
    "lucide": "1.49.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @hash/example build",
    "test": "vitest run",
    "dev": "pnpm --filter @hash/example dev",
    "start": "pnpm --filter @hash/example start",
    "generate:catalog": "node scripts/generate-ui-catalog.ts",
    "generate:icons": "node scripts/generate-icons.ts",
    "package": "pnpm --filter @hash/example package"
  }
}
